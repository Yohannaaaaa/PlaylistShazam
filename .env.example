# Récupère ces valeurs sur https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# URL de base de ton site (doit correspondre au Redirect URI configuré
# dans le dashboard Spotify, suffixé de /api/auth/callback).
# Spotify n'accepte plus "localhost" comme redirect URI : utilise l'IP
# de bouclage 127.0.0.1 en local.
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:3000
